# GEMINI_API_KEY: Required for optional consented Gemini AI document suggestions.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side administrator passcode override.
# If unset, the first administrator account can be claimed securely in the UI.
ADMIN_PASSCODE=
